# Nightgrid Node: optional, read-only agent for the Nightgrid app.
# Installed by `nightgrid-node install`; removed by `nightgrid-node uninstall`.
# It opens no network ports and makes no network connections: the app reaches
# it through a unix socket over the SSH connection it already has.

[Unit]
Description=Nightgrid Node (optional Nightgrid agent)
Documentation=https://github.com/TheRoben-Dev/nightgrid-node
After=local-fs.target

[Service]
Type=notify
NotifyAccess=main
User=nightgrid-node
Group=nightgrid-node
ExecStart=/usr/local/bin/nightgrid-node run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Files: state in /var/lib/nightgrid-node (0700), socket in /run/nightgrid-node.
StateDirectory=nightgrid-node
StateDirectoryMode=0700
RuntimeDirectory=nightgrid-node
RuntimeDirectoryMode=0750
UMask=0007

# Footprint guard rails (the service normally uses a few MB).
MemoryMax=64M
TasksMax=16
CPUWeight=20
IOWeight=20
Nice=10

# No network at all: no listening ports, no outbound connections. (Not
# PrivateNetwork=, which would hide the host's interfaces from /proc/net/dev.)
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

# Least privilege.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-nvidiactl rw
DeviceAllow=char-nvidia-frontend rw
DeviceAllow=char-nvidia-uvm rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
