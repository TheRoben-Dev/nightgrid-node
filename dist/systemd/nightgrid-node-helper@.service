# Nightgrid Node root helper (one process per request; see the .socket).
# Installed by `nightgrid-node allow helper`; removed by `nightgrid-node deny helper`.
# It re-reads the root-owned config (and fixes.toml), accepts only unit.* on
# the units root listed, power.*, firewall.* and fix.* if allowed, runs
# systemctl, shutdown, nft or systemd-run with fixed arguments (no shell),
# answers and exits. Fixes that write outside this sandbox (journal, logs,
# package cache, ~/.ssh, runbooks) run as their own short transient unit.

[Unit]
Description=Nightgrid Node root helper (one request)
Documentation=https://github.com/TheRoben-Dev/nightgrid-node
CollectMode=inactive-or-failed

[Service]
Type=simple
ExecStart=/usr/local/bin/nightgrid-node helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Long enough for a fix (up to 600 s in its own transient unit).
RuntimeMaxSec=630

# Root, but it only talks to systemd and logind over their unix sockets.
# CAP_SYS_BOOT lets logind accept a scheduled reboot without polkit. The
# file capabilities let it snapshot and put back files under [rollback]
# paths with their owner and mode; it can write only there and in its own
# snapshot directory (rollback.conf next to this unit lists the paths).
# CAP_NET_ADMIN and netlink are for nft: firewall.block adds addresses (with
# a timeout) to the node's own table, inet nightgrid_node, and nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_BOOT CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_NET_ADMIN
StateDirectory=nightgrid-node-rollback
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

MemoryMax=32M
TasksMax=8

ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
